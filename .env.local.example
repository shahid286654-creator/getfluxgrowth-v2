# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only: used by lib/supabase/admin.ts for privileged operations
# (never exposed to the browser). Keep this out of version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build auth redirect links (password reset, email
# confirmation). Set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
